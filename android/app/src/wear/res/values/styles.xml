<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The watch UI is black in every theme for WO-V13, so the window behind
         it is black too whatever the OS dark mode setting reports. -->
    <style name="WearLaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Flutter draws its own swipe to dismiss on every screen (WO-V3); the
         window's would close the whole app from any screen instead. -->
    <style name="WearNormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSwipeToDismiss" tools:ignore="WearBackNavigation">false</item>
    </style>
    <style name="LaunchTheme" parent="WearLaunchTheme" />
    <style name="NormalTheme" parent="WearNormalTheme" />
</resources>
