<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- watch_connectivity's isPaired looks for this Pixel Watch companion
         too, but its own manifest only declares the Wear OS and Samsung
         apps, so from Android 11 a Pixel-only pairing read as no watch. -->
    <queries>
        <package android:name="com.google.android.apps.wear.companion" />
    </queries>
    <application>
        <activity
            android:name=".MainActivity"
            tools:node="merge">
            <!-- Opened by the watch's "Use phone" through RemoteActivityHelper;
                 the same link is watchSetupLink in lib/app/router.dart. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="open"
                    android:path="/settings/watch-setup"
                    android:scheme="bsharp" />
            </intent-filter>
        </activity>
    </application>
</manifest>
