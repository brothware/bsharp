  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"school\" TEXT NOT NULL, \"login\" TEXT NOT NULL, \"password_hash\" TEXT NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "translation_cache_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"translation_cache_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"source_hash\" TEXT NOT NULL, \"target_lang\" TEXT NOT NULL, \"translated_text\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "custom_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"custom_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"account_id\" INTEGER NOT NULL REFERENCES accounts (id), \"title\" TEXT NOT NULL, \"place\" TEXT NULL, \"description\" TEXT NULL, \"start_time\" TEXT NOT NULL, \"end_time\" TEXT NOT NULL, \"color_index\" INTEGER NOT NULL DEFAULT 0, \"recurrence_type\" INTEGER NOT NULL DEFAULT 0, \"recurrence_start_date\" INTEGER NULL, \"recurrence_end_date\" INTEGER NULL, \"recurrence_weekdays\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "custom_event_occurrences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"custom_event_occurrences\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"custom_event_id\" INTEGER NOT NULL REFERENCES custom_events (id), \"date\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "ignored_attendances",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ignored_attendances\" (\"attendance_id\" INTEGER NOT NULL, \"ignored_at\" INTEGER NOT NULL, PRIMARY KEY (\"attendance_id\"));"
        }
      ]
    }
